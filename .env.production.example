# Copier en .env sur le VPS, à côté du docker-compose.yml (ou saisir dans Portainer).

APP_IMAGE=ghcr.io/math49/black_pegasus:latest
APP_PORT=40530
POSTGRES_PORT=40531


POSTGRES_USER=black_pegasus
POSTGRES_PASSWORD=a-remplacer-par-un-mot-de-passe-long-et-aleatoire
POSTGRES_DB=black_pegasus


PGADMIN_EMAIL=admin@black-pegasus.exemple.fr
PGADMIN_PASSWORD=a-remplacer-par-un-mot-de-passe-long-et-aleatoire
PGADMIN_PORT=40532


# Adresse publique du site (reverse proxy HTTPS) ; redirection Discord :
# <AUTH_URL>/api/auth/callback/discord
AUTH_URL=https://black-pegasus.exemple.fr
# npx auth secret
AUTH_SECRET=a-remplacer-par-un-secret-de-48-octets-au-moins
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
DISCORD_BOT_TOKEN=

# Premier administrateur (identifiant Discord, 17 à 20 chiffres).
ADMIN_DISCORD_ID=

# Facultatif : jeton des pages imprimées en PDF (tiré au hasard au démarrage si vide).
PDF_TOKEN=


# Première initialisation de la base uniquement (ignorées ensuite, tout se modifie
# dans Paramètres). SOLDE_OUVERTURE : solde de caisse actuel, en dollars entiers.
AGENCE_TELEPHONE=555-0100
AGENCE_HORAIRES=Tous les jours · 14h – 02h
AGENCE_IMMATRICULATION=
SOLDE_OUVERTURE=0
FUSEAU_SERVEUR=Europe/Paris


HEURE_SAUVEGARDE=03
RETENTION_JOURS=14
